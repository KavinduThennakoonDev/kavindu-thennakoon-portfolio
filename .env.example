# Public URL of the deployed site (used for canonical URL, Open Graph, sitemap).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional, server-only. Raises the GitHub API limit from 60 to 5,000 requests/hour.
# A fine-grained token with NO permissions (public data only) is enough.
GITHUB_TOKEN=

# Optional: enables direct contact-form delivery via Resend (free tier).
# Without these, the form opens the visitor's email app (mailto) instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
